  {
    "name": "twilio_make_call",
    "description": "Initiate a phone call via Twilio. Requires a TwiML URL or application SID to control call behavior.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "_accountSid": {
          "type": "string",
          "description": "Twilio Account SID"
        },
        "_authToken": {
          "type": "string",
          "description": "Twilio Auth Token"
        },
        "to": {
          "type": "string",
